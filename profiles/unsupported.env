# A laptop full of hardware the kernel has no driver for.
DESC="q35 with PCI and USB devices that have no Linux driver"
MEM=2560
SMP=2
DISPLAY_ARGS="-device virtio-gpu-pci"
NET_ARGS="-device virtio-net-pci,netdev=n0 -netdev user,id=n0"
EXTRA_ARGS="-device edu -device pci-testdev -device usb-braille -device usb-ccid"
SMBIOS_VENDOR="GeneralResource"
SMBIOS_PRODUCT="PrototypeLaptop"
EXPECT_FILE="unsupported.expect"
