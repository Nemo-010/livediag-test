# A plain machine: virtio disk, virtio network, USB 3 and a GPU.
DESC="baseline q35: virtio disk, network, xHCI and GPU"
MEM=2560
SMP=2
DISPLAY_ARGS="-device virtio-gpu-pci"
NET_ARGS="-device virtio-net-pci,netdev=n0 -netdev user,id=n0"
EXTRA_ARGS=""
SMBIOS_VENDOR="InstallingParty"
SMBIOS_PRODUCT="PrototypeLaptop"
EXPECT_FILE="baseline.expect"
