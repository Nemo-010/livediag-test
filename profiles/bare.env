# No defaults and no network at all; everything optional should skip cleanly.
DESC="bare q35: no default devices and no network"
MEM=2048
SMP=2
MACHINE_EXTRA="-nodefaults"
DISPLAY_ARGS="-device virtio-gpu-pci"
NET_ARGS=""
EXTRA_ARGS=""
SMBIOS_VENDOR="Minimal"
SMBIOS_PRODUCT="Prototype Laptop"
EXPECT_FILE="bare.expect"
