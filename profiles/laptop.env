# A laptop-shaped machine: HDA audio, USB input, a second NIC and an MMC host.
DESC="laptop-shaped q35: HDA audio, USB input, two NICs, MMC host"
MEM=2560
SMP=2
DISPLAY_ARGS="-device virtio-gpu-pci"
NET_ARGS="-device virtio-net-pci,netdev=n0 -netdev user,id=n0"
EXTRA_ARGS="-device intel-hda -device hda-output -device e1000e,netdev=n1 -netdev user,id=n1 -device usb-tablet -device usb-kbd -device sdhci-pci"
SMBIOS_VENDOR="Erusean Systems"
SMBIOS_PRODUCT="Prototype Laptop"
EXPECT_FILE="laptop.expect"
